[Unit]
Description=Lguard full disk scan (every file read and checked again; started from the app)
After=lguard-clamd.service

[Service]
Type=oneshot
ExecStart=/opt/lguard/bin/lguard sweep --full
LoadCredentialEncrypted=lguard-master:/var/lib/lguard/master.cred
Nice=19
IOSchedulingClass=idle
CPUWeight=20

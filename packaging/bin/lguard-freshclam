#!/bin/sh
# The bundled curl has no CA path baked in; use whichever bundle this distro has.
for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
         /etc/ssl/ca-bundle.pem /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/cert.pem; do
  [ -r "$f" ] && { SSL_CERT_FILE=$f; export SSL_CERT_FILE; break; }
done
exec /opt/lguard/clamav/bin/freshclam --config-file=/etc/lguard/freshclam.conf "$@"
